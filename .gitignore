# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/bin/
/dist/

# Go tooling
/vendor/

# Generated projects created by running the CLI locally during development
/tmp-generated/
/.bootstrap-out/

# Plugin binaries + manifests staged for go:embed (see Makefile's
# stage-embedded target and .github/workflows/release.yml) — generated,
# never committed. .gitkeep keeps the package buildable without staging.
/cli/internal/embedded/assets/*
!/cli/internal/embedded/assets/.gitkeep

# Distribution wrapper local build/verification artifacts
/distribution/npm/.bin/
/distribution/npm/*.tgz
/distribution/npm/node_modules/
/distribution/cargo/target/
/distribution/chocolatey/*.nupkg

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
*.swp

# Env / local secrets
.env
.env.local
