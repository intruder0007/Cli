{
  "name": "lumo-cli",
  "version": "0.4.0",
  "description": "Launcher for the Lumo project scaffolding platform — installs the real `lumo` binary (github.com/intruder0007/Lumo) for your platform and runs it with full terminal passthrough.",
  "license": "MIT",
  "author": {
    "name": "intruder0007"
  },
  "homepage": "https://github.com/intruder0007/Lumo#readme",
  "bugs": {
    "url": "https://github.com/intruder0007/Lumo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intruder0007/Lumo.git"
  },
  "keywords": [
    "lumo",
    "scaffolding",
    "project-generator",
    "cli",
    "developer-tools",
    "template"
  ],
  "type": "commonjs",
  "bin": {
    "lumo": "bin/lumo.js"
  },
  "files": [
    "bin",
    "scripts"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/verify-release.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "os": ["linux", "darwin", "win32"],
  "cpu": ["x64", "arm64"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
